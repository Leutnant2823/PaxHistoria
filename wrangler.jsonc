{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strategia",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Custom domain: the bomverao.com zone must be in the same Cloudflare account.
  "routes": [{ "pattern": "strategia.bomverao.com", "custom_domain": true }],
  // Runs the Worker close to the AI provider instead of close to the visitor.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: `wrangler deploy` finds or creates the database by name.
      "database_name": "strategia-db",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // Keep variables added in the dashboard (AUTH_USER etc.) when a new build deploys.
  "keep_vars": true
}
