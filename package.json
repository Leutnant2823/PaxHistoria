{
  "name": "strategia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:map": "node scripts/build-map.mjs 1911 && node scripts/build-map.mjs 1935",
    "typecheck": "tsc -b",
    "dev:worker": "wrangler dev -c wrangler.local.json",
    "deploy": "npm run build && npm run deploy:ci",
    "deploy:ci": "wrangler deploy && wrangler d1 migrations apply strategia-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply strategia-db --local -c wrangler.local.json",
    "db:migrate:remote": "wrangler d1 migrations apply strategia-db --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@turf/turf": "^7.4.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "d3-geo-projection": "^4.0.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
